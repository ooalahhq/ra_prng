# === C ===
# object files dari kompilasi
*.o
# shared library (hasil build)
*.so
# static library
*.a
# executable output
*.out
# folder build artifacts
build/
# binary hasil kompilasi in-place lama (lihat CONTRIBUTING.md - build baru harus ke build/)
src/ra_prng2/c/ra_prng2

# === Python ===
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# hasil python -m build
dist/
*.egg-info/

# === Notebook ===
.ipynb_checkpoints/

# === Data & experiment results ===
data/raw/
results/*.dat
# raw binary dumps from experiments (can reach GB, e.g. PractRand/collision-scan
# stage data) -- already-tracked .bin checkpoints are unaffected by this rule
*.bin

# === IDE & OS ===
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# === Credentials ===
.env
*.key
*.pem
secrets.toml
# detail akses VPS (IP/user) -- repo ini publik, jangan pernah commit
VPS_ACCESS.md

# === Local agent/workspace artifacts & internal notes ===
graphify-out/
CLAUDE.md
.agents/
RESULT.md
docs/PITCH.md

# === Local manuscript drafts, review notes, and LaTeX intermediates ===
research/2026-9_ra-core-paper/DRAFT.md
research/2026-9_ra-core-paper/DRAFT_v1.md
research/2026-9_ra-core-paper/ieee/REVIEW_NOTES.md
research/2026-9_ra-core-paper/ieee/main.blg

# === pip-ra-core: Cython-generated C (regenerated from _bitgen.pyx on every build) ===
pip-ra-core/ra_core/_bitgen.c
pip-ra-core/build/

